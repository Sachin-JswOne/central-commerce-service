            </dependency>
            <dependency>
                <groupId>com.jswonemsme</groupId>
                <artifactId>product.common.util</artifactId>
                <version>0.0.8</version>
            </dependency>
            <dependency>
                <groupId>com.jswonemsme</groupId>
                <artifactId>catalogue_common_model</artifactId>
                <version>0.0.21</version>
            </dependency>
            <dependency>
                <groupId>com.jsw</groupId>
                <artifactId>notification_common_model</artifactId>
                <version>0.0.6</version>
            </dependency>
            <dependency>
                <groupId>com.jswone</groupId>
