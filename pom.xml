    <groupId>com.jswone.central-commerce</groupId>
    <artifactId>central-commerce-service</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>central-commerce-service</name>
    <description>central-commerce-service</description>
    <url/>
    <modules>
        <module>central-commerce-core</module>
        <module>central-commerce-web</module>
        <module>central-commerce-application</module>
        <module>central-commerce-worker</module>
    </modules>
    <properties>
        <java.version>21</java.version>
        <spring-cloud-gcp.version>6.0.0</spring-cloud-gcp.version>
        <spring-cloud.version>2024.0.0</spring-cloud.version>
        <jacoco-maven-plugin.version>0.8.12</jacoco-maven-plugin.version>
        <flatten-maven-plugin.version>1.0.0</flatten-maven-plugin.version>
        <revision>0.0.1-SNAPSHOT</revision>
